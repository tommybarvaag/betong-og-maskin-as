# ── Sanity ────────────────────────────────────────────────────────────────
# projectId is hardcoded in src/sanity/lib/client.ts (public, never changes): t6pwhwps
NEXT_PUBLIC_SANITY_DATASET=staging        # 'staging' in dev, 'production' at launch
SANITY_API_READ_TOKEN=                    # Viewer-role token (drafts/visual editing); server-only
SANITY_REVALIDATE_SECRET=                 # shared secret for the publish webhook signature

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.betongogmaskin.no

# ── Resend (contact form) ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=kontakt@betongogmaskin.no     # must be a Resend-verified domain
CONTACT_TO=joar@betongogmaskin.no
CONTACT_BCC=jmork@online.no

# ── Cloudflare Turnstile (contact form) ─────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
